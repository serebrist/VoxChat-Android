<resources>
    <!-- Base application theme -->
    <style name="Theme.VoxChat" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#E2BE09</item>
        <item name="colorPrimaryVariant">#C4A508</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorSecondary">#E2BE09</item>
        <item name="colorSecondaryVariant">#C4A508</item>
        <item name="colorOnSecondary">#000000</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:navigationBarColor">?attr/colorPrimaryVariant</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="Theme.VoxChat.Splash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
    </style>

    <!-- Full Screen Theme (для звонков и медиа) -->
    <style name="Theme.VoxChat.FullScreen" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>
</resources>
